{
  "$schema": "https://opencode.ai/config.json",
  "mode": {
    "build": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  },
  "disabled_providers": [
    "zai",
    "z-ai",
    "z.ai",
    "zhipu",
    "zhipu-ai",
    "zhipuai",
    "z-ai-coding-plan",
    "z.ai-coding-plan",
    "zai-coding-plan"
  ],
  "provider": {
    "claude": {
      "models": {
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "options": {
            "thinking": {
              "display": "summarized",
              "type": "adaptive"
            }
          },
          "variants": {
            "high": {
              "thinking": {
                "budgetTokens": 16000,
                "display": "summarized",
                "type": "adaptive"
              }
            },
            "low": {
              "thinking": {
                "type": "disabled"
              }
            },
            "max": {
              "thinking": {
                "budgetTokens": 128000,
                "display": "summarized",
                "type": "adaptive"
              }
            },
            "medium": {
              "thinking": {
                "budgetTokens": 8000,
                "display": "summarized",
                "type": "adaptive"
              }
            },
            "xhigh": {
              "thinking": {
                "budgetTokens": 64000,
                "display": "summarized",
                "type": "adaptive"
              }
            }
          }
        }
      },
      "name": "Anthropic",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{env:CC_API_KEY}",
        "baseURL": "https://slb-v1.api.fan/v1",
        "setCacheKey": true
      }
    },
