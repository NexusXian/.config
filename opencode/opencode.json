{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@ex-machina/opencode-anthropic-auth",
  ],
  "mode": {
    "build": {
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  },
  "disabled_providers": [
    "zai",
    "z-ai",
    "z.ai",
    "zhipu",
    "zhipu-ai",
    "zhipuai",
    "z-ai-coding-plan",
    "z.ai-coding-plan",
    "zai-coding-plan"
  ],
  "provider": {
    "RCode_ClaudeCode": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic-AWS",
      "options": {
        "baseURL": "https://right.codes/claude-aws/v1",
        "apiKey": "{env:RIGHT_CODE}"
      },
      "models": {
        "claude-haiku-4-5": {
          "id": "claude-haiku-4-5",
          "name": "Claude Haiku 4.5",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "release_date": "2025-10-15",
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "cost": {
            "input": 1,
            "output": 5,
            "cache_read": 0.1,
            "cache_write": 1.25
          },
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 32000
            }
          }
        },
        "claude-sonnet-5": {
          "id": "claude-sonnet-5",
          "name": "Claude Sonnet 5",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "cost": {
            "input": 3,
            "output": 15,
            "cache_read": 0.3,
            "cache_write": 3.75
          },
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 32000
            }
          }
        },
        "claude-opus-5-5": {
          "id": "claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "cost": {
            "input": 5,
            "output": 25,
            "cache_read": 0.5,
            "cache_write": 6.25
          },
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 32000
            }
          }
        }
      }
    }
  },
  "mcp": {
    "tracker": {
      "type": "local",
      "command": [
        "/Users/nexus/.local/bin/tracker-mcp"
      ],
      "enabled": true
    },
    "pinchtab": {
      "type": "local",
      "command": [
        "node",
        "/Users/nexus/.config/opencode/tools/pinchtab-mcp.mjs"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
