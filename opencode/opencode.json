{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "system": "You are Claude Code, Anthropic's official CLI for Claude."
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "zai", "effect": "deny" },
    { "action": "provider.use", "resource": "z-ai", "effect": "deny" },
    { "action": "provider.use", "resource": "z.ai", "effect": "deny" },
    { "action": "provider.use", "resource": "zhipu", "effect": "deny" },
    { "action": "provider.use", "resource": "zhipu-ai", "effect": "deny" },
    { "action": "provider.use", "resource": "zhipuai", "effect": "deny" },
    { "action": "provider.use", "resource": "z-ai-coding-plan", "effect": "deny" },
    { "action": "provider.use", "resource": "z.ai-coding-plan", "effect": "deny" },
    { "action": "provider.use", "resource": "zai-coding-plan", "effect": "deny" }
  ],
  "providers": {
    "RCode_ClaudeCode": {
      "package": "aisdk:@ai-sdk/anthropic",
      "name": "Anthropic",
      "settings": {
        "baseURL": "https://api.site/claude-aws/v1",
        "apiKey": "{env:RIGHT_CODE}"
      },
      "models": {
        "claude-haiku-4-5": {
          "modelID": "claude-haiku-4-5",
          "name": "Claude Haiku 4.5",
          "releaseDate": "2025-10-15",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "cost": {
            "input": 1,
            "output": 5,
            "cache": {
              "read": 0.1,
              "write": 1.25
            }
          },
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-sonnet-5": {
          "modelID": "claude-sonnet-5",
          "name": "Claude Sonnet 5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "cost": {
            "input": 3,
            "output": 15,
            "cache": {
              "read": 0.3,
              "write": 3.75
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-opus-5-5": {
          "modelID": "claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "cost": {
            "input": 5,
            "output": 25,
            "cache": {
              "read": 0.5,
              "write": 6.25
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "tracker": {
        "type": "local",
        "command": ["/Users/nexus/.local/bin/tracker-mcp"],
        "disabled": false
      },
      "pinchtab": {
        "type": "local",
        "command": [
          "node",
          "/Users/nexus/.config/opencode/tools/pinchtab-mcp.mjs"
        ],
        "disabled": false
      }
    }
  }
}
